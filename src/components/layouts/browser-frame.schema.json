{
  "type": "browser-frame",
  "label": "Browser Frame",
  "category": "layouts",
  "description": "Content displayed inside a browser chrome mockup with title bar dots and URL bar.",
  "data": {
    "url": {
      "type": "string",
      "label": "URL",
      "optional": true,
      "placeholder": "https://example.com"
    },
    "title": {
      "type": "string",
      "label": "Title",
      "optional": true
    },
    "content_html": {
      "type": "string",
      "label": "Content HTML",
      "optional": true
    },
    "screenshot_url": {
      "type": "string",
      "label": "Screenshot URL",
      "optional": true
    }
  },
  "script_actions": [
    {
      "action": "type",
      "description": "Type into the URL bar or page inputs"
    },
    {
      "action": "click",
      "description": "Click on page elements or navigation"
    },
    {
      "action": "scroll",
      "description": "Scroll the page content"
    },
    {
      "action": "zoom-to",
      "description": "Zoom into a section of the page"
    }
  ],
  "default_cursor_targets": {
    "url-bar": {
      "x": "50%",
      "y": "5%"
    },
    "content-area": {
      "x": "50%",
      "y": "50%"
    }
  }
}
