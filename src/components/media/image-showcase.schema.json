{
  "type": "image-showcase",
  "label": "Image Showcase",
  "category": "media",
  "description": "One image presented as a hero: framed, lifted with a soft shadow and glow, an optional caption under it.",
  "data": {
    "src": {
      "type": "string",
      "label": "Image URL or path",
      "optional": true
    },
    "alt": {
      "type": "string",
      "label": "Alt text, shown as placeholder if no src",
      "optional": true
    },
    "effect": {
      "type": "string",
      "label": "Animation effect",
      "optional": true,
      "enum": [
        "ken-burns",
        "reveal-left",
        "reveal-right",
        "zoom-in",
        "fade"
      ],
      "default": "ken-burns"
    },
    "caption": {
      "type": "string",
      "label": "Caption text below image",
      "optional": true
    }
  }
}
