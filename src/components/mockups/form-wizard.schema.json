{
  "type": "form-wizard",
  "label": "Form Wizard",
  "category": "mockups",
  "description": "Multi-step form with typing animation, step indicator, and glass card styling.",
  "data": {
    "steps": {
      "type": "array",
      "label": "Steps",
      "required": true,
      "items": {
        "label": {
          "type": "string",
          "label": "Step Label",
          "required": true
        },
        "fields": {
          "type": "array",
          "label": "Fields",
          "items": {
            "label": {
              "type": "string",
              "label": "Field Label",
              "required": true
            },
            "value": {
              "type": "string",
              "label": "Field Value",
              "optional": true
            },
            "type": {
              "type": "string",
              "label": "Field Type",
              "optional": true,
              "placeholder": "text"
            }
          }
        }
      }
    }
  },
  "script_actions": [
    {
      "action": "type",
      "description": "Type into a form field"
    },
    {
      "action": "click",
      "description": "Click a field or Next/Submit button"
    },
    {
      "action": "show-element",
      "description": "Reveal the next step"
    }
  ],
  "default_cursor_targets": {
    "field-1": {
      "x": "50%",
      "y": "45%"
    },
    "field-2": {
      "x": "50%",
      "y": "55%"
    },
    "next-button": {
      "x": "55%",
      "y": "75%"
    }
  }
}
