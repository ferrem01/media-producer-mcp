{
  "type": "dashboard-kpi",
  "label": "KPI Dashboard",
  "category": "mockups",
  "description": "Realistic KPI dashboard with metric cards, sparkline charts, and count-up animations.",
  "data": {
    "title": {
      "type": "string",
      "label": "Dashboard Title",
      "optional": true,
      "default": "Dashboard"
    },
    "metrics": {
      "type": "array",
      "label": "Metrics",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "label": "Metric Label",
            "required": true
          },
          "value": {
            "type": "number",
            "label": "Value",
            "required": true
          },
          "change": {
            "type": "number",
            "label": "Change %",
            "optional": true
          },
          "prefix": {
            "type": "string",
            "label": "Prefix",
            "optional": true,
            "placeholder": "$"
          },
          "suffix": {
            "type": "string",
            "label": "Suffix",
            "optional": true,
            "placeholder": "%"
          },
          "chart_data": {
            "type": "array",
            "label": "Sparkline Data",
            "optional": true,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "script_actions": [
    {
      "action": "click",
      "description": "Click on a metric card or chart"
    },
    {
      "action": "hover",
      "description": "Hover over a metric to show details"
    },
    {
      "action": "zoom-to",
      "description": "Zoom into a specific metric"
    },
    {
      "action": "update-value",
      "description": "Animate a metric value changing"
    }
  ],
  "default_cursor_targets": {
    "metric-1": {
      "x": "20%",
      "y": "35%"
    },
    "metric-2": {
      "x": "50%",
      "y": "35%"
    },
    "metric-3": {
      "x": "80%",
      "y": "35%"
    },
    "chart-area": {
      "x": "50%",
      "y": "70%"
    }
  }
}
