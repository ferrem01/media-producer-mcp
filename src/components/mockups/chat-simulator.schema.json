{
  "type": "chat-simulator",
  "label": "Chat Simulator",
  "category": "mockups",
  "description": "Slack/Discord/iMessage style chat interface. Messages appear one by one with typing indicators.",
  "data": {
    "platform": {
      "type": "string",
      "label": "Platform",
      "optional": true,
      "enum": [
        "slack",
        "discord",
        "imessage"
      ],
      "default": "slack"
    },
    "channel": {
      "type": "string",
      "label": "Channel Name",
      "optional": true,
      "placeholder": "general"
    },
    "messages": {
      "type": "array",
      "label": "Messages",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "label": "Username",
            "required": true
          },
          "text": {
            "type": "string",
            "label": "Message Text",
            "required": true
          },
          "avatar_color": {
            "type": "string",
            "label": "Avatar Color",
            "optional": true
          },
          "time": {
            "type": "string",
            "label": "Timestamp",
            "optional": true,
            "placeholder": "10:32 AM"
          }
        }
      }
    }
  },
  "script_actions": [
    {
      "action": "type",
      "description": "Type a message into the chat input"
    },
    {
      "action": "click",
      "description": "Click the send button or other UI elements"
    },
    {
      "action": "show-response",
      "description": "Display an AI or bot response message"
    },
    {
      "action": "show-typing",
      "description": "Show typing indicator"
    }
  ],
  "default_cursor_targets": {
    "chat-input": {
      "x": "50%",
      "y": "90%"
    },
    "send-button": {
      "x": "92%",
      "y": "90%"
    }
  }
}
