{
  "type": "kanban-board",
  "label": "Kanban Board",
  "category": "mockups",
  "description": "Trello-style board with cards moving between columns. Glass card tiles with animated card movement.",
  "data": {
    "columns": {
      "type": "array",
      "label": "Columns",
      "required": true,
      "items": {
        "title": {
          "type": "string",
          "label": "Column Title",
          "required": true
        },
        "cards": {
          "type": "array",
          "label": "Cards",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "move": {
      "type": "object",
      "label": "Card Movement",
      "optional": true,
      "properties": {
        "card": {
          "type": "string",
          "label": "Card Name"
        },
        "from": {
          "type": "number",
          "label": "From Column Index"
        },
        "to": {
          "type": "number",
          "label": "To Column Index"
        }
      }
    }
  },
  "script_actions": [
    {
      "action": "drag",
      "description": "Drag a card from one column to another"
    },
    {
      "action": "click",
      "description": "Click on a card to expand"
    },
    {
      "action": "hover",
      "description": "Hover over a card"
    }
  ],
  "default_cursor_targets": {
    "col-1-card-1": {
      "x": "17%",
      "y": "35%"
    },
    "col-2-card-1": {
      "x": "50%",
      "y": "35%"
    },
    "col-3-card-1": {
      "x": "83%",
      "y": "35%"
    }
  }
}
