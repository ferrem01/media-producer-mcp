{
  "type": "code-editor",
  "label": "Code Editor",
  "category": "mockups",
  "description": "VSCode-style code editor with syntax highlighting, line numbers, and typing effect.",
  "data": {
    "filename": {
      "type": "string",
      "label": "Filename",
      "optional": true,
      "default": "index.ts"
    },
    "code": {
      "type": "string",
      "label": "Code",
      "required": true
    },
    "language": {
      "type": "string",
      "label": "Language",
      "optional": true,
      "default": "typescript"
    },
    "theme": {
      "type": "string",
      "label": "Theme",
      "optional": true,
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark"
    }
  },
  "script_actions": [
    {
      "action": "type",
      "description": "Type code into the editor"
    },
    {
      "action": "click",
      "description": "Click on a line or UI element"
    },
    {
      "action": "highlight",
      "description": "Highlight a code section"
    },
    {
      "action": "zoom-to",
      "description": "Zoom into a code region"
    }
  ],
  "default_cursor_targets": {
    "editor": {
      "x": "50%",
      "y": "50%"
    },
    "tab-bar": {
      "x": "30%",
      "y": "8%"
    }
  }
}
