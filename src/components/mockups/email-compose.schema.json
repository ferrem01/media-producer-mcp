{
  "type": "email-compose",
  "label": "Email Compose",
  "category": "mockups",
  "description": "Email being composed in a dark mail client mockup with typing animation and send button glow.",
  "data": {
    "to": {
      "type": "string",
      "label": "To",
      "optional": true,
      "placeholder": "team@company.com"
    },
    "from": {
      "type": "string",
      "label": "From",
      "optional": true,
      "placeholder": "you@company.com"
    },
    "subject": {
      "type": "string",
      "label": "Subject",
      "optional": true,
      "placeholder": "Quick Update"
    },
    "body": {
      "type": "string",
      "label": "Body",
      "optional": true
    }
  },
  "script_actions": [
    {
      "action": "type",
      "description": "Type text into the email body or fields"
    },
    {
      "action": "click",
      "description": "Click To, Subject, or Send button"
    }
  ],
  "default_cursor_targets": {
    "to-field": {
      "x": "50%",
      "y": "20%"
    },
    "subject-field": {
      "x": "50%",
      "y": "30%"
    },
    "body-field": {
      "x": "50%",
      "y": "55%"
    },
    "send-button": {
      "x": "15%",
      "y": "85%"
    }
  }
}
