{
  "type": "number-counter-row",
  "label": "Number Counter Row",
  "category": "titles",
  "description": "Multiple stats side by side with animated count-up numbers and glass dividers. count:'roll' spins each digit into place like an odometer -- use it when the brief asks for rolling / ticking digits.",
  "data": {
    "stats": {
      "type": "array",
      "label": "Stats",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "label": "Value",
            "required": true
          },
          "label": {
            "type": "string",
            "label": "Label",
            "required": true
          },
          "prefix": {
            "type": "string",
            "label": "Prefix",
            "optional": true,
            "placeholder": "$"
          },
          "suffix": {
            "type": "string",
            "label": "Suffix",
            "optional": true,
            "placeholder": "%"
          }
        }
      }
    },
    "count": {
      "type": "string",
      "label": "count (default: the number counts up) | roll (odometer: each digit spins into place -- prices, metrics)",
      "optional": true,
      "enum": [
        "count",
        "roll"
      ]
    }
  }
}
