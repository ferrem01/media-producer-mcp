{
  "type": "metric-dashboard",
  "label": "Metric Dashboard",
  "category": "data-viz",
  "description": "A grid of KPI cards, each counting up to its value with a label, change and a mini sparkline.",
  "data": {
    "metrics": {
      "type": "array",
      "label": "Metrics: [{ label, value, prefix?, suffix?, change? (percent, drives the arrow), good? ('down' when a fall is good news, e.g. unsubscribes), chart_data? (numbers for a sparkline) }]",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          },
          "change": {
            "type": "number",
            "description": "Percentage change indicator"
          }
        },
        "required": [
          "value",
          "label"
        ]
      }
    },
    "columns": {
      "type": "number",
      "label": "Number of grid columns",
      "optional": true,
      "default": 3
    }
  }
}
