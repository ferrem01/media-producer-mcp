{
  "id": "story-ad-idea-beats",
  "name": "Story ad: idea beats",
  "grammar": "hype-cut",
  "frames_proven": [
    "9x16"
  ],
  "suits": [
    "a story ad with no person",
    "a feeling the viewer knows, then the fix",
    "pain, product, payoff in fifteen seconds",
    "sign up or start free"
  ],
  "length_s": [
    14,
    22
  ],
  "spine": [
    {
      "role": "hook",
      "shot": "type_card",
      "dur": [
        1.5,
        2,
        2.5
      ],
      "enters": [
        "keyword:type-on"
      ],
      "note": "The feeling, in four words or fewer, typed word by word on the world; no product yet."
    },
    {
      "role": "pain",
      "shot": "idea_card",
      "dur": [
        2,
        2.5,
        3.5
      ],
      "repeat": [
        1,
        2
      ],
      "enters": [
        "keyword:type-on",
        "object:slide-up"
      ],
      "note": "The problem as one line over the one object that stands for it (a clock for the hours); the object slides up under the words and holds; the ugly artifact may sit behind it."
    },
    {
      "role": "reveal",
      "shot": "screen",
      "dur": [
        1.5,
        2,
        2.5
      ],
      "enters": [
        "stamp:wordmark"
      ],
      "note": "The product's wordmark lands big with its device in the world; no line."
    },
    {
      "role": "proof",
      "shot": "screen",
      "dur": [
        2,
        2.5,
        3.5
      ],
      "repeat": [
        1,
        2
      ],
      "enters": [
        "keyword:type-on"
      ],
      "cutaway": {
        "at": "start",
        "hold": 1.0,
        "use": "card",
        "kind": "mockup"
      },
      "note": "What it does, one line; the product's real output (decks, pages) fans in beneath the words, never chrome alone."
    },
    {
      "role": "lift",
      "shot": "idea_card",
      "dur": [
        1,
        1.5,
        2
      ],
      "enters": [
        "object:drift"
      ],
      "note": "Objects of the world drift across without words: a breath between proof and payoff."
    },
    {
      "role": "payoff",
      "shot": "type_card",
      "dur": [
        1.5,
        2,
        2.5
      ],
      "enters": [
        "keyword:type-on"
      ],
      "note": "What the viewer gets back, four words; the last word lands alone."
    },
    {
      "role": "cta",
      "shot": "idea_card",
      "dur": [
        3.5,
        4.5,
        5.5
      ],
      "enters": [
        "stamp:wordmark",
        "button:cta",
        "end_card@start"
      ],
      "note": "The wordmark over the last object, a pill button naming the ask, held to the end."
    }
  ],
  "rhythm": {
    "cut_cadence_s": 2.3,
