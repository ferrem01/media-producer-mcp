{
  "name": "media-producer-mcp",
  "version": "0.1.0",
  "description": "Generalized media production MCP server. HTML + GSAP + Playwright + ffmpeg.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/components/shared dist/components/ && cp -r src/templates dist/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "ferrem01",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/ws": "^8.18.1",
    "gsap": "^3.12.7",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.52.0",
    "uuid": "^11.1.0",
    "ws": "^8.21.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
